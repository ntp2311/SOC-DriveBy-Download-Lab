alert icmp any any -> any any (msg:"SOC LAB ICMP TEST";itype:8; sid:1000001; rev:1;)
alert tcp any any -> $HOME_NET any (msg:"SOC LAB POSSIBLE SYN SCAN"; flags:S; threshold:type both, track by_src, count 5, seconds 10; sid:1000002; rev:1;)
alert tcp any any -> $HOME_NET any (msg:"SOC LAB SYN TEST"; flags:S; sid:1000003; rev:1;)
alert http any any -> any any (msg:"SOC LAB Drive-by Download Redirect Endpoint Access"; flow:established,to_server; http.uri; content:"/start"; startswith; endswith; classtype:policy-violation; sid:1000010; rev:1;)
